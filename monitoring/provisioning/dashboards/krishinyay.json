{
  "uid": "krishinyay",
  "title": "KrishiNyay AI",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Farmer queries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "krishinyay-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(krishinyay_queries_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "RAG queries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "krishinyay-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(krishinyay_rag_queries_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Live API queries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "krishinyay-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(krishinyay_live_queries_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Gemini calls",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "krishinyay-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(krishinyay_gemini_calls_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Query latency (p95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "krishinyay-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(krishinyay_query_latency_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "API request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "krishinyay-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (handler) (rate(http_requests_total[5m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
